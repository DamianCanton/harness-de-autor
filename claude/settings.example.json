{
  "permissions": {
    "allow": [
      "mcp__codegraph__*",
      "mcp__engram__mem_capture_passive",
      "mcp__engram__mem_compare",
      "mcp__engram__mem_judge",
      "mcp__engram__mem_pin",
      "mcp__engram__mem_review",
      "mcp__engram__mem_save",
      "mcp__engram__mem_save_prompt",
      "mcp__engram__mem_session_end",
      "mcp__engram__mem_session_start",
      "mcp__engram__mem_session_summary",
      "mcp__engram__mem_unpin",
      "mcp__engram__mem_update",
      "mcp__plugin_engram_engram__mem_capture_passive",
      "mcp__plugin_engram_engram__mem_compare",
      "mcp__plugin_engram_engram__mem_judge",
      "mcp__plugin_engram_engram__mem_pin",
      "mcp__plugin_engram_engram__mem_review",
      "mcp__plugin_engram_engram__mem_save",
      "mcp__plugin_engram_engram__mem_save_prompt",
      "mcp__plugin_engram_engram__mem_session_end",
      "mcp__plugin_engram_engram__mem_session_start",
      "mcp__plugin_engram_engram__mem_session_summary",
      "mcp__plugin_engram_engram__mem_unpin",
      "mcp__plugin_engram_engram__mem_update"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(sudo rm -rf ~)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Read(.ssh/*)",
      "Edit(.ssh/*)",
      "Read(.credentials/*)",
      "Edit(.credentials/*)",
      "Read(Library/Keychains/*)",
      "Edit(Library/Keychains/*)",
      "Read(.aws/credentials)",
      "Edit(.aws/credentials)",
      "Read(.config/gh/hosts.yml)",
      "Edit(.config/gh/hosts.yml)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/secrets/*)",
      "Edit(**/secrets/*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "hyperframes": "off",
    "hyperframes-animation": "off",
    "hyperframes-audio": "off",
    "hyperframes-cli": "off",
    "hyperframes-core": "off",
    "hyperframes-creative": "off",
    "hyperframes-keyframes": "off",
    "hyperframes-registry": "off",
    "hyperframes-studio": "off",
    "media-use": "off",
    "go-testing": "off",
    "gentle-ai-bench": "off",
    "cognitive-doc-design": "off",
    "comment-writer": "off",
    "issue-creation": "off",
    "skill-improver": "off",
    "systemic-issue-triage": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "gentle-ai review stop-hook --agent claude-code",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gentle-ai review stop-hook --agent claude-code",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gentle-ai telemetry runtime claude --json",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gentle-ai telemetry runtime claude --json",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gentle-ai skill-registry refresh --quiet --no-gitignore --cwd \"${CLAUDE_PROJECT_DIR:-$PWD}\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/damian-git-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "engram@engram": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "outputStyle": "Gentleman",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 400000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 400000
    }
  },
  "advisorModel": "opus",
  "promptSuggestionEnabled": false,
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "idleCompaction": true,
  "switchModelsOnFlag": true,
  "crossSessionInbound": "accept"
}